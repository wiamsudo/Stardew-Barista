# =============================================
# Unity .gitignore
# Stardew Barista
# =============================================

# Unity gegenereerde mappen
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Auto-gegenereerde project files
/[Aa]ssets/Plugins/Editor/JetBrains*
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D gegenereerde crash rapporten
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE mappen
.vs/
.vscode/
.idea/
.gradle/

# OS bestanden
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# BELANGRIJK: niet toevoegen
# =============================================
# Voeg hier NOOIT het volgende aan toe:
#
#   **/[Pp]ackages/*   -> negeert Unity's Packages/manifest.json,
#                         waardoor packages zoals Input System
#                         niet meekomen naar een andere pc.
#
#   *.meta             -> meta bestanden bevatten alle import
#                         settings (sprite slicing, pixels per unit).
#                         Zonder deze bestanden is je project op een
#                         andere pc onbruikbaar.